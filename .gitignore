_sessions
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
skills-cache/
.env
*.egg-info/

# Dedicated GKE Terraform root: keep only example inputs and the provider lock file.
terraform/gke/.terraform/
terraform/gke/*.tfstate
terraform/gke/*.tfstate.*
terraform/gke/*.tfplan
terraform/gke/*.plan
terraform/gke/terraform.tfvars
terraform/gke/terraform.tfvars.*
!terraform/gke/terraform.tfvars.example
terraform/gke/*credentials*
terraform/gke/*.json
terraform/gke/*.key
terraform/gke/*.pem
terraform/gke/*.p12

# Per-use-case Terraform state and provider cache.
usecases/*/terraform/.terraform/
usecases/*/terraform/*.tfstate
usecases/*/terraform/*.tfstate.*
usecases/*/terraform/*.tfplan
usecases/*/terraform/*.plan
usecases/*/terraform/terraform.tfvars
usecases/*/terraform/terraform.tfvars.*
!usecases/*/terraform/terraform.tfvars.example
